RAG_BACKEND_PORT=8090
DATABASE_URL="postgresql://user:password@localhost:5432/secondbrain"
GROQ_API_KEY="your-groq-api-key"
GROQ_LLM_MODEL="openai/gpt-oss-120b"
GROQ_ASR_MODEL="whisper-large-v3"
# Vision-capable Groq model used to caption images/video frames — a real
# free-text description, not a pick from a fixed vocabulary (see
# USE_CLIP_ZEROSHOT_TAGGING below).
GROQ_CAPTION_MODEL="qwen/qwen3.6-27b"
# Small/fast model used only to reformulate the raw query before
# embedding/retrieval (rewriteQueryForRetrieval, lib/groq.ts) — on the
# critical path of every /ask call, kept deliberately small.
GROQ_QUERY_REWRITE_MODEL="openai/gpt-oss-20b"
GEMINI_API_KEY="your-gemini-api-key"
QDRANT_URL="https://your-cluster.qdrant.tech"
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_COLLECTION="rag_text"
QDRANT_IMAGE_COLLECTION="rag_images"
QDRANT_VECTOR_SIZE=768
CLIP_SIDECAR_URL="http://localhost:8001"
# Off by default. When true, every retrieval logs each hit's modality/score/
# text-preview — real user content, so leave this off outside local debugging.
DEBUG_RETRIEVAL_LOGGING=false
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
OCR_SPACE_API_KEY="your-ocr-space-api-key"
LLAMA_CLOUD_API_KEY="your-llama-cloud-api-key"
ADMIN_SECRET="your-admin-secret"
# Shared with apps/web's RAG_INTERNAL_SECRET — apps/web sends this on every
# request to rag-backend so it can verify the caller, instead of trusting
# whatever userId is in the body on network isolation alone.
RAG_INTERNAL_SECRET="your-rag-internal-secret"
# Empirically re-tuned (Task 3) against real gemini-embedding-001 (text) and
# CLIP (image) cosine-similarity distributions — see the detailed comments
# in src/lib/config.ts for the score data and reasoning behind each value,
# including two real findings: (1) Gemini cosine scores for ANY two
# passages cluster densely regardless of topical relevance, so these are a
# coarse noise filter, not a precision guarantee; (2) CLIP's cross-modal
# scale is much lower than Gemini's and was previously sharing
# MIN_RELEVANCE_SCORE with it, which was structurally broken — now split
# into its own CLIP_IMAGE_MIN_SCORE below.
MIN_RELEVANCE_SCORE=0.5
CLIP_IMAGE_MIN_SCORE=0.17
IMAGE_TAG_SCORE_THRESHOLD=0.52
IMAGE_FOCUSED_TEXT_SCORE_THRESHOLD=0.5
MIN_OVERALL_SCORE=0.45

# Set true to use CLIP's fixed-vocabulary zero-shot tagging (clip-sidecar's
# /tag-image) instead of Groq's free-text image captioning. Off by default —
# CLIP's forced choice among a short candidate list produced wrong tags
# outranking correct ones in a tight score band (e.g. a mountain photo's own
# "mountain" tag losing to "ocean"/"boat"); kept only for rollback.
USE_CLIP_ZEROSHOT_TAGGING=false

# Only relevant if USE_CLIP_ZEROSHOT_TAGGING=true above. Must match
# clip-sidecar's own CLIP_TAG_THRESHOLD/CLIP_TAG_TOP_N — separate processes,
# separate environments, so both must be set if overriding.
CLIP_TAG_THRESHOLD=0.19
CLIP_TAG_TOP_N=5

# Keyframes sampled per video for visual (CLIP) tagging (lib/video.ts).
MAX_VIDEO_FRAMES=8

# A sampled video frame is dropped if its CLIP embedding is at least this
# cosine-similar to a frame already kept from the same video in the same
# indexing run (dedupes near-static footage).
VIDEO_FRAME_DEDUPE_THRESHOLD=0.97