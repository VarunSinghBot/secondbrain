# Copy to .env and fill in. Names and defaults mirror apps/rag-backend/.env.example.
# Unit tests need none of these; integration tests read GEMINI_API_KEY if present.

DATABASE_URL=
RAG_INTERNAL_SECRET=
ADMIN_SECRET=

GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_ASR_MODEL=whisper-large-v3
GROQ_CAPTION_MODEL=qwen/qwen3.6-27b
GROQ_QUERY_REWRITE_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
LLAMA_CLOUD_API_KEY=
OCR_SPACE_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_text
QDRANT_IMAGE_COLLECTION=rag_images
QDRANT_VECTOR_SIZE=768

CLIP_TAG_THRESHOLD=0.19
CLIP_TAG_TOP_N=5
