node_modules/
.next/
dist/
build/
.turbo/
coverage/

# Env files — every variant except the committed .env.example templates.
# Note: RAG_JOBS_FILE-style env overrides that point somewhere else aren't
# (and can't be) covered here — gitignore can't follow a path set at runtime,
# only the default locations documented elsewhere in this file.
.env
.env.*
!.env.example

.DS_Store
Thumbs.db
.idea/
*.log

# Generated Prisma client output for rag-backend and web (regenerate with
# `pnpm db:generate`) — not shared via git.
apps/rag-backend/src/generated/
apps/web/src/generated/

# Python virtualenv for clip-sidecar (created locally, not shared via git)
clip-sidecar/.venv/

# Compiled Python bytecode (clip-sidecar) — regenerated automatically, not shared via git
__pycache__/
*.pyc

# Local job store for rag-backend's file-based queue (worker/queue.ts) —
# contains real ingested content text from local runs, and is per-machine
# state, not something to share via git.
apps/rag-backend/.rag_jobs.json
apps/rag-backend/.rag_jobs.*.tmp

# TS incremental build cache — regenerate with `tsc`/`next dev`, per-machine.
*.tsbuildinfo

# Ad-hoc test media dropped in apps/rag-backend/ during manual RAG pipeline
# testing (real photos/audio/video/PDFs used to exercise ingestion
# end-to-end for a specific task, e.g. "test-mountain.jpg", "task4-audio-
# note.wav") — scratch fixtures, not imported/referenced by anything, safe
# to accumulate and delete freely between sessions.
apps/rag-backend/test-*.jpg
apps/rag-backend/test-*.wav
apps/rag-backend/test-*.mp4
apps/rag-backend/test-*.pdf
apps/rag-backend/task*-*.wav
apps/rag-backend/task*-*.mp4
