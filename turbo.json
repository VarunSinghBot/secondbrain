{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev":        { "cache": false, "persistent": true },
    "lint":       {},
    "type-check": {},
    "db:push":     { "cache": false },
    "db:generate": { "cache": false },
    "db:studio":   { "cache": false, "persistent": true },
    "db:migrate":  { "cache": false },
    "clean":       { "cache": false }
  }
}
